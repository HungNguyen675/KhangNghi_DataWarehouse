      DTS:ObjectName="Execute SQL Task"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F63AD35-333E-41B8-9BA7-712208D8B375}"
          SQLTask:SqlStatementSource="-- Dọn dẹp dữ liệu cũ (nếu có)&#xA;DELETE FROM Dim_Time;&#xA;DBCC CHECKIDENT ('Dim_Time', RESEED, 0);&#xA;&#xA;-- Thiết lập mốc thời gian (Ví dụ sinh ra 5 năm liên tục: 2022 - 2026)&#xA;DECLARE @StartDate DATE = '2010-01-01'; &#xA;DECLARE @EndDate DATE = '2026-12-31';   &#xA;DECLARE @CurrentDate DATE = @StartDate;&#xA;&#xA;-- Bắt đầu vòng lặp tự động đẻ ra các ngày&#xA;WHILE @CurrentDate &lt;= @EndDate&#xA;BEGIN&#xA;    INSERT INTO Dim_Time (&#xA;        FullDate, &#xA;        [Day], &#xA;        [Month], &#xA;        [Quarter], &#xA;        [Year], &#xA;        SourceSystem, &#xA;        CreatedDate, &#xA;        UpdatedDate&#xA;    )&#xA;    VALUES (&#xA;        @CurrentDate,&#xA;        DAY(@CurrentDate),&#xA;        MONTH(@CurrentDate),&#xA;        DATEPART(QUARTER, @CurrentDate), -- Hàm tự động tính ra Quý&#xA;        YEAR(@CurrentDate),&#xA;        'SSIS_ETL',&#xA;        GETDATE(),&#xA;        GETDATE()&#xA;    );&#xA;    &#xA;    -- Cộng thêm 1 ngày để lặp tiếp&#xA;    SET @CurrentDate = DATEADD(DAY, 1, @CurrentDate);&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
