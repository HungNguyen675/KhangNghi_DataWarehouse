            <component
              refId="Package\DFT - Gộp dữ liệu Bán Hàng (Nguồn 1 + 2)\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    ROW_NUMBER() OVER(ORDER BY o.OrderID) AS [Row ID],
    o.OrderID AS [Order ID],
    o.OrderDate AS [Order Date],
    o.OrderPriority AS [Order Priority],
    o.SalesChannel AS [Sales Channel],
    o.PaymentMethod AS [Payment Method],
    c.CustomerID AS [Customer ID],
    c.CustomerName AS [Customer Name],
    c.Segment AS Segment,
    l.LocationID AS [Location ID],
    l.PostalCode AS [Postal Code],
    l.City AS City,
    l.State AS State,
    l.Country AS Country,
    l.Region AS Region,
    l.Market AS Market,
    m.ManufacturerName AS Manufacturer,
    p.ProductID AS [Product ID],
    p.Category AS Category,
    p.SubCategory AS [Sub-Category],
    p.ProductName AS [Product Name],
    p.ServiceType AS [Service],
    e.EmployeeName AS [Employee Name],
    pr.PromotionName AS [Promotion Name],
    od.Quantity AS Quantity,
    od.Sales AS Sales,
    od.Discount AS Discount,
    od.Profit AS Profit,
    sh.ShipDate AS [Ship Date],
    sh.ShipMode AS [Ship Mode],
    sh.ShippingCost AS [Shipping Cost],
    sh.Warehouse AS Warehouse
FROM KhangNghi_OLTP.dbo.Orders o
JOIN KhangNghi_OLTP.dbo.OrderDetails od ON o.OrderID = od.OrderID
JOIN KhangNghi_OLTP.dbo.Customers c ON o.CustomerID = c.CustomerID
JOIN KhangNghi_OLTP.dbo.Locations l ON o.LocationID = l.LocationID
JOIN KhangNghi_OLTP.dbo.Products p ON od.ProductID = p.ProductID
JOIN KhangNghi_OLTP.dbo.Manufacturers m ON p.ManufacturerID = m.ManufacturerID
LEFT JOIN KhangNghi_OLTP.dbo.Employees e ON o.EmployeeID = e.EmployeeID
LEFT JOIN KhangNghi_OLTP.dbo.Promotions pr ON o.PromotionID = pr.PromotionID
LEFT JOIN KhangNghi_OLTP.dbo.Shipments sh ON o.OrderID = sh.OrderID
WHERE o.OrderDate &gt; ?</property>
