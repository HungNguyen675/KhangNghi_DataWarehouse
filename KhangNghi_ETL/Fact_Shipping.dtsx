                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE AS (
    SELECT 
        CAST([Order ID] AS NVARCHAR(50)) AS OrderID,
        CAST([Ship Date] AS DATE) AS ShipDate_Cast,
        CAST([Location ID] AS NVARCHAR(255)) AS LocationID_Cast,
        CAST([Ship Mode] AS NVARCHAR(255)) AS ShipMode_Cast,
        CAST(Warehouse AS NVARCHAR(255)) AS Warehouse_Cast,
        CAST([Shipping Cost] AS FLOAT) AS ShippingCost,
        -- Lệnh DATEDIFF sẽ tự động lấy Ngày Giao trừ đi Ngày Đặt ra số ngày
        DATEDIFF(day, [Order Date], [Ship Date]) AS DeliveryDays,
        0 AS LateDays, 
        ROW_NUMBER() OVER(PARTITION BY [Order ID] ORDER BY [Order Date] DESC) as rn
    FROM KhangNghi_Staging.dbo.Stg_KhangNghiData
    WHERE [Order ID] IS NOT NULL
)
SELECT * FROM CTE WHERE rn = 1;</property>
                <property
