              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[dbo].[Stg_KhangNghiData]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    -- 10 ổ khóa trỏ tới 10 bảng Dim của Fact_Sales
    CAST('SALE_' + CAST(LTRIM(RTRIM([Order ID])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS OrderID,
    CAST('SALE_' + CAST(LTRIM(RTRIM([Customer ID])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS CustomerID,
    CAST('SALE_' + CAST(LTRIM(RTRIM([Product ID])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS ProductID,
    CAST('SALE_' + CAST(LTRIM(RTRIM([Location ID])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS LocationID,
    CAST('SALE_' + CAST(LTRIM(RTRIM([Employee Name])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS EmployeeID,
    CAST('SALE_' + CAST(LTRIM(RTRIM([Manufacturer])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS ManufacturerID,
    CAST('SALE_' + CAST(LTRIM(RTRIM([Promotion Name])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS PromotionID,
    CAST('SALE_' + CAST(LTRIM(RTRIM([Sales Channel])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS SalesChannelID,
    CAST('SALE_' + CAST(LTRIM(RTRIM([Payment Method])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS PaymentMethodID,
    CAST('SALE_' + CAST(LTRIM(RTRIM([Service])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS ServiceID,
   
    CAST([Order Date] AS DATE) AS [Order Date],
    CAST([Ship Date] AS DATE) AS [Ship Date],
    
    -- Các cột số liệu (Measures)
    [Sales], 
    [Quantity], 
    [Discount], 
    [Profit], 
    [Order Priority]
FROM dbo.Stg_KhangNghiData
WHERE [Order Date] &gt;= ?</property>
