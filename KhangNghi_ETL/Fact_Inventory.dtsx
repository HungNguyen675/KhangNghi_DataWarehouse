              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH InventoryTransactions AS (
    -- 1. Lấy giao dịch NHẬP KHO (mang dấu Cộng)
    SELECT 
        CAST([PurchaseDate] AS DATE) AS InventoryDate,
        CAST('PUR_' + CAST(LTRIM(RTRIM([ProductID])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS ProductID,
        CAST('PUR_Unknown' AS NVARCHAR(50)) AS LocationID, -- Mua hàng không có Location, gán tạm mác Unknown
        CAST('PUR_' + CAST(LTRIM(RTRIM([Warehouse])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS WarehouseID,
        [Quantity] AS QuantityIn,
        0 AS QuantityOut
    FROM dbo.Stg_PurchaseHistory
    WHERE [PurchaseDate] &gt;= ?
    
    UNION ALL
    
    -- 2. Lấy giao dịch XUẤT KHO (mang dấu Trừ)
    SELECT 
        CAST([Order Date] AS DATE) AS InventoryDate,
        CAST('SALE_' + CAST(LTRIM(RTRIM([Product ID])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS ProductID,
        CAST('SALE_' + CAST(LTRIM(RTRIM([Location ID])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS LocationID,
        CAST('SALE_' + CAST(LTRIM(RTRIM([Warehouse])) AS NVARCHAR(50)) AS NVARCHAR(50)) AS WarehouseID,
        0 AS QuantityIn,
        [Quantity] AS QuantityOut
    FROM dbo.Stg_KhangNghiData
    WHERE [Order Date] &gt;= ?
)
-- 3. Gom nhóm và tính toán Tồn kho
SELECT 
    InventoryDate,
    ProductID,
    LocationID,
    WarehouseID,
    SUM(QuantityIn) AS QuantityIn,
    SUM(QuantityOut) AS QuantityOut,
    -- Tồn kho trong ngày = Nhập - Xuất
    SUM(QuantityIn) - SUM(QuantityOut) AS QuantityOnHand,
    -- Tạm gán mức cảnh báo nhập hàng là 50
    50 AS ReorderLevel
FROM InventoryTransactions
GROUP BY InventoryDate, ProductID, LocationID, WarehouseID</property>
                <property
