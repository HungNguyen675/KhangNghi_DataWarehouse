# =============================================================================
# KHANG NGHI BI AI COPILOT - CẤU HÌNH GOOGLE GEMINI (GOOGLE AI STUDIO)
# -----------------------------------------------------------------------------
# Cách dùng: copy file này thành ".env" (cùng thư mục KhangNghi.Api) rồi điền giá trị.
# File .env chứa API key nên KHÔNG được commit (đã có trong .gitignore).
#
# 1. Cấu hình Google Gemini (Khuyên dùng):
# Lấy API key miễn phí hoặc trả phí tại Google AI Studio: https://aistudio.google.com/
# Model: chỉ dùng model có trong danh sách ListModels của key và đã gọi thử thành công
# (xem BAO_CAO_FIX_AI_COPILOT.md). Model mới thường có hạn mức rất thấp với key miễn phí.
# =============================================================================

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Tổng thời gian chờ Gemini cho mỗi câu hỏi (giây); quá hạn thì trả lời bằng chế độ offline
GEMINI_TIMEOUT_SECONDS=20
# Số lần thử lại khi Gemini quá tải (HTTP 503); không thử lại khi hết quota (429) hoặc sai key
GEMINI_MAX_RETRIES=1

# =============================================================================
# 2. Cấu hình tương thích OpenAI / Nhà cung cấp khác (Tùy chọn):
# Nếu không đặt GEMINI_API_KEY, hệ thống sẽ tự động đọc các biến dưới đây:
#   OpenAI:      OPENAI_BASE_URL=https://api.openai.com/v1
#   OpenRouter:  OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Groq:        OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   Ollama:      OPENAI_BASE_URL=http://localhost:11434/v1
# =============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60
