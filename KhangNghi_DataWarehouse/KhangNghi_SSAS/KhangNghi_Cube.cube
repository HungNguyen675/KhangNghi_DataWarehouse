  <MdxScripts>
    <MdxScript dwd:design-time-name="4b1e57b1-da39-4aa0-b856-ff1aaa444a47">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[On Time Delivery Rate]
 AS IIF(
    [Measures].[Known Deliveries] = 0,
    NULL,
    [Measures].[On Time Deliveries]
    / IIF(
        [Measures].[Known Deliveries] = 0,
        1,
        [Measures].[Known Deliveries]
    )
), 
FORMAT_STRING = "0.00%",
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>