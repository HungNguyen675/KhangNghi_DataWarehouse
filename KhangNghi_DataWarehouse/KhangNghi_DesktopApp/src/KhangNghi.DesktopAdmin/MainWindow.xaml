<?xml version='1.0' encoding='UTF-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" x:Class="KhangNghi.DesktopAdmin.MainWindow" mc:Ignorable="d" Title="Khang Nghị | Quản trị kho dữ liệu" Height="900" Width="1380" MinHeight="740" MinWidth="1100" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{StaticResource BackgroundBrush}" xmlns:local="clr-namespace:KhangNghi.DesktopAdmin">
    <Window.Resources>
        <local:RoleDisplayConverter x:Key="RoleDisplayConverter"/>
