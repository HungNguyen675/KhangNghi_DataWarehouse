                    </Grid.RowDefinitions>
                    <TextBlock Text="Cập nhật dữ liệu" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,15" TextWrapping="Wrap"/>
