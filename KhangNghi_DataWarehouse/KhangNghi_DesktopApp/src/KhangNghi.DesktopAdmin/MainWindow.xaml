                    <RotateTransform Angle="-9"/>
                  </Border.RenderTransform>
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" Foreground="#5B4797"/>
                </Border>
              </Grid>
            </Grid>
          </Border>
                    <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
