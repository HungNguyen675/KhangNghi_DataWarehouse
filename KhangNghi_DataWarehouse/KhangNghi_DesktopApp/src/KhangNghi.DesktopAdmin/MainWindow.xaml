            <StackPanel>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Chế độ nạp dữ liệu:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
