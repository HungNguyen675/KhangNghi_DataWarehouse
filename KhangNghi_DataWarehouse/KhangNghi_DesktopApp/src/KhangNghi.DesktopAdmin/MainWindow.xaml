                                <TextBlock x:Name="TxtFactPurchaseCount" Text="..."
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="#8B5CF6" Margin="0,8,0,6"/>

                                <TextBlock Text="Bản ghi · Fact_Purchase"
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="6,0,0,0"
            Style="{StaticResource CardStyle}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="DỮ LIỆU TỒN KHO"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>

                                <TextBlock x:Name="TxtFactInventoryCount" Text="..."
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="#D97706" Margin="0,8,0,6"/>

                                <TextBlock Text="Bản ghi · Fact_Inventory"
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Grid.Row="3" Margin="0,0,0,14" Style="{StaticResource CardStyle}" Padding="14">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Các bảng trong kho dữ liệu · 13 chiều và 4 bảng sự kiện" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>
              <DataGrid x:Name="GridDwhTables" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="Transparent" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32" ColumnHeaderHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên bảng"
                        Binding="{Binding TableName}"
                        Width="2*" MinWidth="220"/>

                                    <DataGridTextColumn Header="Loại bảng"
                        Binding="{Binding TableType}"
                        Width="*" MinWidth="130"/>

                                    <DataGridTextColumn Header="Số bản ghi"
                        Binding="{Binding RowCount, StringFormat={}{0:N0}}"
                        Width="*" MinWidth="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="0,0,16,0"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
            </DockPanel>
          </Border>
          <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="14,10">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Trạng thái khối phân tích" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
