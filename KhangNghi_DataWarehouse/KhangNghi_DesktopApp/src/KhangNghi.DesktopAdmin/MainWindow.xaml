                                                        <ToolTip MaxWidth="650">
                                                            <TextBlock Text="{Binding OriginalMessage}"
                                   TextWrapping="Wrap"/>
                                                        </ToolTip>
                                                    </TextBlock.ToolTip>
            </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
