            Style="{StaticResource CardStyle}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="DỮ LIỆU BÁN HÀNG"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>

                                <TextBlock x:Name="TxtFactOrderCount" Text="..."
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Margin="0,8,0,6"/>

                                <TextBlock Text="Bản ghi · Fact_Sales"
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="6,0,6,0"
            Style="{StaticResource CardStyle}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="DỮ LIỆU VẬN CHUYỂN"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>

                                <TextBlock x:Name="TxtFactShippingCount" Text="..."
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource SuccessBrush}"
                       Margin="0,8,0,6"/>

                                <TextBlock Text="Bản ghi · Fact_Shipping"
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

