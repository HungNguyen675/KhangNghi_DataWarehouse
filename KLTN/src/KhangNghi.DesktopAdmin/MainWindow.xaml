<Window x:Class="KhangNghi.DesktopAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KhangNghi.DesktopAdmin"
        mc:Ignorable="d"
        Title="Hệ Thống Quản Trị Kho Dữ Liệu Khang Nghị - Administrator Desktop" 
        Height="720" Width="1140" 
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <!-- MAIN APPLICATION LAYOUT (HIDDEN UNTIL LOGGED IN) -->
        <Grid x:Name="MainAppGrid" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                <DockPanel LastChildFill="True">
                    <!-- App Brand Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="20,25,20,30">
                        <TextBlock Text="KHANG NGHỊ DWH" Foreground="White" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Administrator Control Panel" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- User Profile & Logout at Bottom -->
                    <Border DockPanel.Dock="Bottom" Background="#0A0F1D" Padding="15,12" Margin="10">
                        <StackPanel>
                            <TextBlock Text="Đang đăng nhập: admin" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="Vai trò: Quản trị viên (Admin)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,8" />
                            <Button Content="Đăng xuất" Background="#334155" FontSize="12" Padding="8,5" Click="BtnLogout_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Nav Navigation Menu -->
                    <StackPanel Margin="10,0">
                        <Button x:Name="NavOverview" Content="📊  Tổng Quan Hệ Thống" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,4" Background="Transparent" Foreground="#E2E8F0" Click="Nav_Click" Tag="PanelOverview" />
                        <Button x:Name="NavUsers" Content="👥  Quản Trị Người Dùng" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,4" Background="Transparent" Foreground="#E2E8F0" Click="Nav_Click" Tag="PanelUsers" />
                        <Button x:Name="NavDatabase" Content="🗄️  Cài Đặt &amp; Kết Nối CSDL" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,4" Background="Transparent" Foreground="#E2E8F0" Click="Nav_Click" Tag="PanelDatabase" />
                        <Button x:Name="NavEtl" Content="⚡  Kích Hoạt Luồng ETL" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,4" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="Nav_Click" Tag="PanelEtl" />
                        <Button x:Name="NavSchedule" Content="⏰  Lập Lịch Tự Động" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,4" Background="Transparent" Foreground="#E2E8F0" Click="Nav_Click" Tag="PanelSchedule" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- MAIN CONTENT PANELS -->
            <Grid Grid.Column="1" Margin="25">
                <!-- 1. PANEL: TỔNG QUAN HỆ THỐNG -->
                <Grid x:Name="PanelOverview" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Tổng Quan Trạng Thái Kho Dữ Liệu" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,20" />

                    <!-- Quick KPI Cards -->
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
                        <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Fact Bán Hàng (Orders)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                <TextBlock x:Name="TxtFactOrderCount" Text="..." FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Padding="15" Margin="5,0,5,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Fact Vận Chuyển" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                <TextBlock x:Name="TxtFactShippingCount" Text="..." FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Padding="15" Margin="5,0,5,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Fact Mua Hàng" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                <TextBlock x:Name="TxtFactPurchaseCount" Text="..." FontSize="22" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Padding="15" Margin="10,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Fact Tồn Kho" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                <TextBlock x:Name="TxtFactInventoryCount" Text="..." FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Table of Tables Status -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Chi Tiết Số Lượng Dữ Liệu Từng Bảng (DWH Tables)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15" />
                            <DataGrid x:Name="GridDwhTables" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="Transparent" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên Bảng" Binding="{Binding TableName}" Width="250" />
                                    <DataGridTextColumn Header="Phân Loại" Binding="{Binding TableType}" Width="150" />
                                    <DataGridTextColumn Header="Tổng Số Bản Ghi" Binding="{Binding RowCount, StringFormat={}{0:N0}}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- 2. PANEL: QUẢN TRỊ NGƯỜI DÙNG -->
                <Grid x:Name="PanelUsers" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Quản Trị Người Dùng &amp; Phân Quyền Hệ Thống" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,20" />

                    <!-- User DataGrid -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,15">
                        <DataGrid x:Name="GridUsers" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="Transparent" SelectionChanged="GridUsers_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding UserID}" Width="60" />
                                <DataGridTextColumn Header="Tên Đăng Nhập" Binding="{Binding Username}" Width="150" />
                                <DataGridTextColumn Header="Họ Và Tên" Binding="{Binding FullName}" Width="220" />
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200" />
                                <DataGridTextColumn Header="Vai Trò / Quyền" Binding="{Binding Role}" Width="150" />
                                <DataGridCheckBoxColumn Header="Kích Hoạt" Binding="{Binding IsActive}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Add/Edit Form -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Thông Tin Chi Tiết Người Dùng" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Tên đăng nhập:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtUserUsername" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,10,0">
                                    <TextBlock Text="Họ và tên:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtUserFullName" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="5,0,10,0">
                                    <TextBlock Text="Vai trò (Role):" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CmbUserRole" Padding="8,7" SelectedIndex="0">
                                        <ComboBoxItem Content="Admin" />
                                        <ComboBoxItem Content="Director" />
                                        <ComboBoxItem Content="InventoryManager" />
                                        <ComboBoxItem Content="ShippingStaff" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Orientation="Horizontal">
                                    <Button Content="Thêm Mới" Margin="5,0" Click="BtnAddUser_Click" />
                                    <Button Content="Cập Nhật" Margin="5,0" Background="#10B981" Click="BtnUpdateUser_Click" />
                                    <Button Content="Xóa" Margin="5,0" Background="#EF4444" Click="BtnDeleteUser_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. PANEL: KẾT NỐI & CÀI ĐẶT CSDL -->
                <Grid x:Name="PanelDatabase" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Cấu Hình Kết Nối Kho Dữ Liệu SQL Server" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,20" />

                        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Chuỗi kết nối (Connection String):" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBox x:Name="TxtConnectionString" Text="http://localhost:5000" Margin="0,0,0,15" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Kiểm tra API" Click="BtnTestConnection_Click" Margin="0,0,10,0" />
                                    <Button Content="Lưu URL" Background="#10B981" Click="BtnSaveConnection_Click" />
                                </StackPanel>
                                <TextBlock x:Name="TxtConnectionResult" Text="Sẵn sàng Kiểm tra API..." Margin="0,15,0,0" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 4. PANEL: KÍCH HOẠT LUỒNG ETL -->
                <Grid x:Name="PanelEtl" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Kích Hoạt &amp; Giám Sát Luồng Nạp Dữ Liệu (ETL Pipeline)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,20" />

                    <!-- Trigger Control Card -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Tệp nguồn Excel vận hành của Khang Nghị:" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtExcelSourcePath" Text="d:\VS_source\KLTN\Data.xlsx" />
                                <Button Grid.Column="1" Content="Duyệt Tệp..." Margin="10,0,0,0" Background="#475569" Click="BtnBrowseExcel_Click" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="BtnRunEtl" Content="🚀  KÍCH HOẠT NẠP DỮ LIỆU ETL" Background="{StaticResource PrimaryBrush}" FontSize="14" Padding="20,12" Click="BtnRunEtl_Click" />
                                <TextBlock x:Name="TxtEtlStatus" Text="Sẵn sàng nạp dữ liệu..." VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                            </StackPanel>

                            <ProgressBar x:Name="EtlProgressBar" Height="8" IsIndeterminate="False" Value="0" Maximum="100" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Console Logs -->
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Console Log Tiến Trình Nạp Dữ Liệu Trực Tiếp:" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ScrollViewer x:Name="ScrollLog">
                                <TextBlock x:Name="TxtConsoleLog" Foreground="#38BDF8" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- History Execution Log Grid -->
                    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Lịch Sử Thực Thi ETL (Sys_EtlLog)" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <DataGrid x:Name="GridEtlHistory" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Log" Binding="{Binding LogID}" Width="70" />
                                    <DataGridTextColumn Header="Thời Gian Bắt Đầu" Binding="{Binding StartTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="160" />
                                    <DataGridTextColumn Header="Thời Gian Kết Thúc" Binding="{Binding EndTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="160" />
                                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="100" />
                                    <DataGridTextColumn Header="Số Dòng Nạp" Binding="{Binding RowsInserted, StringFormat={}{0:N0}}" Width="120" />
                                    <DataGridTextColumn Header="Người Kích Hoạt" Binding="{Binding TriggeredBy}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- 5. PANEL: LẬP LỊCH TỰ ĐỘNG -->
                <Grid x:Name="PanelSchedule" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Cấu Hình Lập Lịch Tự Động (Auto-Scheduler)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,20" />

                        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="ChkEnableSchedule" Content="Bật chế độ tự động cập nhật kho dữ liệu định kỳ" FontSize="14" FontWeight="SemiBold" IsChecked="True" Margin="0,0,0,20" />

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Tần suất lặp lại:" Margin="0,0,0,5" />
                                        <ComboBox x:Name="CmbFrequency" SelectedIndex="0" Padding="8,7">
                                            <ComboBoxItem Content="Mỗi đêm (Daily)" />
                                            <ComboBoxItem Content="Mỗi 12 tiếng" />
                                            <ComboBoxItem Content="Mỗi 6 tiếng" />
                                            <ComboBoxItem Content="Mỗi giờ (Hourly)" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,10,0">
                                        <TextBlock Text="Giờ chạy (0 - 23):" Margin="0,0,0,5" />
                                        <TextBox x:Name="TxtScheduleHour" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                        <TextBlock Text="Phút chạy (0 - 59):" Margin="0,0,0,5" />
                                        <TextBox x:Name="TxtScheduleMinute" Text="0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Lưu Cấu Hình Lập Lịch" Click="BtnSaveSchedule_Click" />
                                </StackPanel>

                                <TextBlock x:Name="TxtScheduleInfo" Text="Hệ thống đã kích hoạt: Lịch chạy kế tiếp vào lúc 00:00 đêm nay." Margin="0,20,0,0" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- LOGIN OVERLAY DIALOG (DISPLAYED FIRST) -->
        <Grid x:Name="LoginOverlay" Background="#0F172A">
            <Border Background="White" CornerRadius="12" Width="400" Padding="35" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.3" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="KHANG NGHỊ DWH" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Đăng Nhập Quản Trị Viên (Admin Login)" FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,25" />

                    <TextBlock Text="Tên đăng nhập:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" />
                    <TextBox x:Name="TxtLoginUsername" Text="admin" Margin="0,0,0,15" />

                    <TextBlock Text="Mật khẩu:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" />
                    <PasswordBox x:Name="TxtLoginPassword" Password="admin123" Margin="0,0,0,20" />

                    <Button Content="ĐĂNG NHẬP HỆ THỐNG" FontSize="14" Padding="0,12" Click="BtnLogin_Click" />

                    <TextBlock x:Name="TxtLoginError" Foreground="{StaticResource DangerBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Tài khoản mặc định: admin / admin123" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>


