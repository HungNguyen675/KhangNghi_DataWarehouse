# =============================================================================
# AI Copilot - Tầng 3: hỏi đáp bằng ngôn ngữ tự nhiên (LLM gọi tool Q01-Q40)
# -----------------------------------------------------------------------------
# Cách dùng: copy file này thành ".env" (cùng thư mục KhangNghi.Api) rồi điền giá trị.
# File .env chứa API key nên KHÔNG được commit (đã có trong .gitignore).
# Để trống OPENAI_MODEL thì tầng 3 tắt, Copilot chỉ dùng luật từ khóa như cũ.
#
# Dùng được với mọi API tương thích OpenAI (endpoint /chat/completions có hỗ trợ tools):
#   OpenAI      OPENAI_BASE_URL=https://api.openai.com/v1
#   OpenRouter  OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Groq        OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   Ollama      OPENAI_BASE_URL=http://localhost:11434/v1   (không cần API key)
#   LM Studio   OPENAI_BASE_URL=http://localhost:1234/v1    (không cần API key)
# Model bắt buộc phải hỗ trợ function / tool calling.
# Ghi chú phải nằm trên dòng riêng, không viết sau giá trị.
# =============================================================================

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Thời gian chờ tối đa cho mỗi lần gọi model (giây)
OPENAI_TIMEOUT_SECONDS=60
