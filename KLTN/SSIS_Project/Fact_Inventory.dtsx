      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="2 Cập nhật Mốc thời gian mới"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DAD8EF47-9109-4893-846E-3C87FEE1DBC4}"
          SQLTask:SqlStatementSource="UPDATE dbo.ETL_Config SET Last_Load_Date=COALESCE((SELECT MAX(D) FROM(SELECT MAX(CONVERT(date,[Ship Date])) D FROM dbo.Stg_KhangNghiData UNION ALL SELECT MAX(CONVERT(date,PurchaseDate)) FROM dbo.Stg_PurchaseHistory) q),Last_Load_Date) WHERE TableName=N'KhangNghi_Inventory'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
