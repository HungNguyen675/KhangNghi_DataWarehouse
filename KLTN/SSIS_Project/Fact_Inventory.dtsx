            <component
              refId="Package\Data Flow Task\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET NOCOUNT ON;
DECLARE @FromIn date=?,@FromOut date=?;
DECLARE @Warehouses TABLE(WarehouseID nvarchar(50) PRIMARY KEY,WarehouseName nvarchar(255) UNIQUE,LocationID nvarchar(50));
DECLARE @Events TABLE(EventDate date,SKU nvarchar(50),WarehouseID nvarchar(50),QuantityIn bigint,QuantityOut bigint);
DECLARE @Daily TABLE(SKU nvarchar(50),WarehouseID nvarchar(50),EventDate date,QuantityIn bigint,QuantityOut bigint,PRIMARY KEY(SKU,WarehouseID,EventDate));
DECLARE @Pairs TABLE(SKU nvarchar(50),WarehouseID nvarchar(50),FirstActivity date,PRIMARY KEY(SKU,WarehouseID));
DECLARE @Rows TABLE(InventoryDate date,ProductID nvarchar(50),LocationID nvarchar(50),WarehouseID nvarchar(50),QuantityIn int,QuantityOut int,QuantityOnHand int,ReorderLevel int);
INSERT @Warehouses SELECT w.WarehouseID,w.WarehouseName,JSON_VALUE(m.RecordPayload,N'$.locationId')
FROM KhangNghi_Purchasing_OLTP_VN_DRAFT.dbo.Warehouses w JOIN KhangNghi_OLTP_VN_DRAFT.vn.SimMasterRecord m ON m.EntityType=N'Warehouse' AND m.BusinessKey COLLATE DATABASE_DEFAULT=w.WarehouseID COLLATE DATABASE_DEFAULT AND m.MasterVersion=N'VN-MASTER-2022-2025-001';
INSERT @Events SELECT CONVERT(date,p.PurchaseDate),p.ProductID,w.WarehouseID,CONVERT(bigint,p.Quantity),0 FROM dbo.Stg_PurchaseHistory p JOIN @Warehouses w ON w.WarehouseID=p.Warehouse
UNION ALL SELECT CONVERT(date,s.[Ship Date]),s.[Product ID],w.WarehouseID,0,CONVERT(bigint,s.Quantity) FROM dbo.Stg_KhangNghiData s JOIN @Warehouses w ON w.WarehouseName=s.Warehouse;
IF (SELECT COUNT_BIG(*) FROM @Events)&lt;&gt;(SELECT COUNT_BIG(*) FROM dbo.Stg_PurchaseHistory)+(SELECT COUNT_BIG(*) FROM dbo.Stg_KhangNghiData) THROW 51000,'Inventory warehouse mapping lost movements.',1;
IF EXISTS(SELECT 1 FROM KhangNghi_OLTP_VN_DRAFT.dbo.Returns) OR EXISTS(SELECT 1 FROM KhangNghi_Purchasing_OLTP_VN_DRAFT.dbo.PurchaseReturns) THROW 51000,'Return movements require explicit inventory mapping.',1;
INSERT @Pairs SELECT SKU,WarehouseID,MIN(EventDate) FROM @Events GROUP BY SKU,WarehouseID;
INSERT @Daily SELECT SKU,WarehouseID,EventDate,SUM(QuantityIn),SUM(QuantityOut) FROM @Events GROUP BY SKU,WarehouseID,EventDate;
DECLARE @Last date=(SELECT MAX(EventDate) FROM @Events);
;WITH Balances AS(
 SELECT p.SKU,p.WarehouseID,t.FullDate SnapshotDate,COALESCE(d.QuantityIn,0) QuantityIn,COALESCE(d.QuantityOut,0) QuantityOut,
 SUM(COALESCE(d.QuantityIn,0)-COALESCE(d.QuantityOut,0)) OVER(PARTITION BY p.SKU,p.WarehouseID ORDER BY t.FullDate ROWS UNBOUNDED PRECEDING) QuantityOnHand
 FROM @Pairs p JOIN DWH_KhangNghi.dbo.Dim_Time t ON t.FullDate BETWEEN p.FirstActivity AND @Last
 LEFT JOIN @Daily d ON d.SKU=p.SKU AND d.WarehouseID=p.WarehouseID AND d.EventDate=t.FullDate
)
INSERT @Rows SELECT b.SnapshotDate,CAST(N'SALE_'+b.SKU AS nvarchar(50)),CAST(N'SALE_'+w.LocationID AS nvarchar(50)),CAST(N'SALE_'+w.WarehouseName AS nvarchar(50)),CONVERT(int,b.QuantityIn),CONVERT(int,b.QuantityOut),CONVERT(int,b.QuantityOnHand),p.ReorderLevel
FROM Balances b JOIN @Warehouses w ON w.WarehouseID=b.WarehouseID JOIN KhangNghi_Purchasing_OLTP_VN_DRAFT.dbo.Products p ON p.ProductID=b.SKU
WHERE b.SnapshotDate&gt;=CASE WHEN @FromIn&lt;@FromOut THEN @FromIn ELSE @FromOut END
AND NOT EXISTS(SELECT 1 FROM DWH_KhangNghi.dbo.Fact_Inventory old JOIN DWH_KhangNghi.dbo.Dim_Time dt ON dt.TimeKey=old.TimeKey JOIN DWH_KhangNghi.dbo.Dim_Product dp ON dp.ProductKey=old.ProductKey JOIN DWH_KhangNghi.dbo.Dim_Warehouse dw ON dw.WarehouseKey=old.WarehouseKey WHERE old.SourceSystem=N'SSIS_ETL' AND dt.FullDate=b.SnapshotDate AND dp.ProductID=N'SALE_'+b.SKU AND dw.WarehouseID=N'SALE_'+w.WarehouseName AND old.QuantityIn=b.QuantityIn AND old.QuantityOut=b.QuantityOut AND old.QuantityOnHand=b.QuantityOnHand AND old.ReorderLevel=p.ReorderLevel)
OPTION(RECOMPILE);
IF EXISTS(SELECT 1 FROM @Rows WHERE QuantityOnHand&lt;0 OR QuantityIn&lt;0 OR QuantityOut&lt;0 OR ReorderLevel IS NULL) THROW 51000,'Invalid inventory balance/policy; stop before destination.',1;
SELECT InventoryDate,ProductID,LocationID,WarehouseID,QuantityIn,QuantityOut,QuantityOnHand,ReorderLevel FROM @Rows;
</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
